# ─── Smart Calligraphy — Production Environment ──────────────────────────
# Copy to .env and fill in real values before deploying.
# cp .env.production.example .env
#
# IMPORTANT: Keep .env out of version control (.gitignore already configured).

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=8000
STORAGE_ROOT=./storage

# ── Database ─────────────────────────────────────────────────────────────
# SQLite (dev default; switch to PostgreSQL/MySQL for production)
DATABASE_URL=sqlite:///./smart_calligraphy.db
# DATABASE_URL=postgresql://user:password@host:5432/calligraphy
# DATABASE_URL=mysql+pymysql://user:password@host:3306/calligraphy

# ── Security ─────────────────────────────────────────────────────────────
JWT_SECRET=please-change-to-random-secret
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(64))"

# In production, static resources (/uploads) require Bearer token
SECURE_STATIC=true

# CORS — restrict to your actual domains (no wildcards in production)
CORS_ORIGINS=https://teacher.your-domain.com,https://student.your-domain.com
# CORS_ORIGINS=https://teacher.example.com,https://student.example.com

# Demo account password (change before deploying)
DEMO_PASSWORD=please-change-me

# ── AI Evaluation (Qwen3.5-omni-plus via Alibaba Cloud DashScope) ────────
# Enable only if you have a valid API Key.
QWEN_EVALUATION_ENABLED=false
# QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EVALUATION_MODEL=qwen3.5-omni-plus
QWEN_IMAGE_MAX_SIZE=768
QWEN_IMAGE_DETAIL=low

# ── AI Evaluation (OpenAI — deprecated, kept for reference) ──────────────
# OPENAI_EVALUATION_ENABLED=false
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EVALUATION_MODEL=gpt-4.1
# OPENAI_IMAGE_MAX_SIZE=768
# OPENAI_IMAGE_DETAIL=low
