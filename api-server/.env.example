APP_ENV=dev
APP_PORT=8000
STORAGE_ROOT=./storage
DATABASE_URL=sqlite:///./smart_calligraphy.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=calligraphy
DB_USER=root
DB_PASSWORD=your_password
JWT_SECRET=change_me
AI_SERVICE_URL=http://127.0.0.1:9001
EVALUATION_PROVIDER=mock
# OpenAI 评测（DEPRECATED: 请改用 Qwen）
#OPENAI_EVALUATION_ENABLED=false
#OPENAI_API_KEY=
#OPENAI_BASE_URL=
#OPENAI_EVALUATION_MODEL=gpt-4.1
#OPENAI_IMAGE_DETAIL=low
#OPENAI_IMAGE_MAX_SIZE=768

# Qwen3.5-Plus 视觉评测（阿里云百炼 DashScope, 国内直连, 支付宝付款）
# 开通: 阿里云百炼控制台 -> 模型广场 -> qwen3.5-plus -> 申请 API Key
QWEN_EVALUATION_ENABLED=false
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EVALUATION_MODEL=qwen3.5-plus   # 397B 原生多模态，¥0.8/百万输入，性价比最高
# 备选: qwen-vl-plus (~7B, ¥0.8/百万), qwen-vl-max (~72B, ¥1.6/百万)
QWEN_IMAGE_MAX_SIZE=768
QWEN_IMAGE_DETAIL=low
