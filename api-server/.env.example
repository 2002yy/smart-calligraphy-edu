APP_ENV=dev
APP_PORT=8000
STORAGE_ROOT=./storage
DATABASE_URL=sqlite:///./smart_calligraphy.db

DEMO_PASSWORD=123456

# 安全配置
# 外网演示时建议开启：
SECURE_STATIC=false      # 开启后 /uploads 静态资源需 Bearer token 才能访问
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
                         # 外网演示时改为实际域名，例如：
                         # CORS_ORIGINS=https://teacher.your-domain.com,https://student.your-domain.com

# Qwen3.5-omni-plus 视觉评测
# 开通: 阿里云百炼 -> 模型广场 -> qwen3.5-omni-plus -> 申请 API Key
# 配置后设置 QWEN_EVALUATION_ENABLED=true，填入 QWEN_API_KEY
QWEN_EVALUATION_ENABLED=false
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EVALUATION_MODEL=qwen3.5-omni-plus
QWEN_IMAGE_MAX_SIZE=768
QWEN_IMAGE_DETAIL=low

# 结果图叠加中文字体路径（可选，自动搜索系统字体）
# Linux 部署建议安装 Noto CJK: apt install fonts-noto-cjk
# 或手动指定: CALLIGRAPHY_FONT_PATH=/usr/share/fonts/.../NotoSansCJK-Regular.ttc
# CALLIGRAPHY_FONT_PATH=
